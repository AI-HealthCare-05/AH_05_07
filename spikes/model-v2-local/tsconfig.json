{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "skipLibCheck": true, "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["adapter.ts", "runtime.ts", "main.ts", "verification.ts"]
}
