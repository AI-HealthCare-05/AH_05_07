{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sk7-asset-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "routes": [{"pattern":"assets.hyeol.app","custom_domain":true}],
  "vars": {
    "ALLOWED_ORIGINS": "https://hyeol.app,https://www.hyeol.app",
    "ASSET_MOUNTS_JSON": "{\"sk7\":{\"binding\":\"SK7_ASSETS\",\"prefix\":\"\"}}"
  },
  "r2_buckets": [{"binding":"SK7_ASSETS","bucket_name":"sk7-assets-prod"}],
  "observability": {"enabled":true}
}
