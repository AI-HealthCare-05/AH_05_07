{
  "dataset_id": "nhanes-2017-march-2020-prepandemic",
  "source": "https://wwwn.cdc.gov/nchs/nhanes/continuousnhanes/default.aspx?Cycle=2017-2020",
  "unit_of_analysis": "participant",
  "join_key": "SEQN",
  "files": {
    "demographics": "P_DEMO.xpt",
    "body_measures": "P_BMX.xpt",
    "blood_pressure": "P_BPXO.xpt",
    "physical_activity": "P_PAQ.xpt",
    "smoking": "P_SMQ.xpt",
    "alcohol": "P_ALQ.xpt",
    "sleep": "P_SLQ.xpt"
  },
  "module_columns": {
    "demographics": ["RIAGENDR", "RIDAGEYR"],
    "body_measures": ["BMXBMI"],
    "blood_pressure": ["BPXOSY1", "BPXOSY2", "BPXOSY3", "BPXODI1", "BPXODI2", "BPXODI3"],
    "physical_activity": ["PAQ605", "PAQ620"],
    "smoking": ["SMQ020"],
    "alcohol": ["ALQ111"],
    "sleep": ["SLD012"]
  },
  "label": {
    "name": "hypertension_risk_group",
    "derivation": "mean of available BPXOSY1..BPXOSY3 >= 130 OR mean of available BPXODI1..BPXODI3 >= 80",
    "prohibited_predictors": ["BPXOSY1", "BPXOSY2", "BPXOSY3", "BPXODI1", "BPXODI2", "BPXODI3"]
  },
  "candidate_predictors": ["RIAGENDR", "RIDAGEYR", "BMXBMI", "PAQ605", "PAQ620", "SMQ020", "ALQ111", "SLD012"],
  "exclusions": ["identifiers except SEQN for joining", "free text", "dates", "diagnosis and treatment fields", "unavailable-at-inference fields"],
  "split": {"seed": 20260901, "train": 0.7, "validation": 0.15, "test": 0.15},
  "status": "schema_audit_required_before_training"
}
