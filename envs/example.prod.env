# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
APP_VERSION=v1.0.0
SECRET_KEY=replace-with-a-server-only-secret
COOKIE_DOMAIN=localhost
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
API_CORS_ORIGINS=https://your-pages-domain.pages.dev

# verified risk model (mounted outside the image and repository)
RISK_MODEL_ARTIFACT=/models/risk-model.joblib
RISK_MODEL_METADATA=/models/risk-model.metadata.json
RISK_MODEL_SPLIT_DIGEST=replace-with-frozen-split-digest
MODEL_MOUNT_PATH=/absolute/host/path/to/models

# ai-worker
AI_WORKER_VERSION=v1.0.0

# db
DB_HOST=mysql
DB_PORT=3306
DB_EXPOSE_PORT=3306
DB_USER=ozcoding
DB_PASSWORD=replace-with-a-server-only-secret
DB_ROOT_PASSWORD=replace-with-a-server-only-secret
DB_NAME=ai_health

# redis
REDIS_PORT=6379
